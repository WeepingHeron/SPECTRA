{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectra.local/simulation/mvp-decision-result.schema.json",
  "title": "SPECTRA MVP Decision Engine Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "case_id", "data_class", "input_hash", "output_hash", "processing_status", "engineering_gate", "assurance_decision", "baseline", "variant", "change_impact"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^mvp-[a-f0-9]{16}$"},
    "case_id": {"type": "string", "minLength": 1},
    "data_class": {"const": "SYNTHETIC"},
    "input_hash": {"$ref": "https://spectra.local/schemas/common.schema.json#/$defs/sha256"},
    "output_hash": {"$ref": "https://spectra.local/schemas/common.schema.json#/$defs/sha256"},
    "processing_status": {"const": "VALID"},
    "engineering_gate": {"const": "NOT_EVALUATED"},
    "assurance_decision": {"const": "HOLD"},
    "baseline": {"$ref": "#/$defs/scenarioResult"},
    "variant": {"$ref": "#/$defs/scenarioResult"},
    "change_impact": {"$ref": "https://spectra.local/simulation/change-impact.schema.json"}
  },
  "$defs": {
    "scenarioResult": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "result_id", "ecc_enabled", "policy_approval_status", "calculation_status", "engineering_gate", "assurance_decision", "metrics", "rule_results", "evidence_gaps", "evidence_packet"],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "result_id": {"type": "string", "pattern": "^result-[a-f0-9]{16}$"},
        "ecc_enabled": {"type": "boolean"},
        "policy_approval_status": {"type": "string", "enum": ["DRAFT", "PENDING_APPROVAL", "APPROVED", "REJECTED", "REVOKED", "SUPERSEDED"]},
        "calculation_status": {"const": "CALCULATED_SYNTHETIC"},
        "engineering_gate": {"const": "NOT_EVALUATED"},
        "assurance_decision": {"const": "HOLD"},
        "metrics": {
          "type": "object", "additionalProperties": false,
          "required": ["shielded_tid", "required_tid", "raw_seu", "residual_logical_errors", "corrected", "detected_uncorrectable", "silent_uncorrected"],
          "properties": {
            "shielded_tid": {"$ref": "https://spectra.local/schemas/common.schema.json#/$defs/quantity"},
            "required_tid": {"$ref": "https://spectra.local/schemas/common.schema.json#/$defs/quantity"},
            "raw_seu": {"$ref": "https://spectra.local/schemas/common.schema.json#/$defs/quantity"},
            "residual_logical_errors": {"$ref": "https://spectra.local/schemas/common.schema.json#/$defs/quantity"},
            "corrected": {"$ref": "https://spectra.local/schemas/common.schema.json#/$defs/quantity"},
            "detected_uncorrectable": {"$ref": "https://spectra.local/schemas/common.schema.json#/$defs/quantity"},
            "silent_uncorrected": {"$ref": "https://spectra.local/schemas/common.schema.json#/$defs/quantity"}
          }
        },
        "rule_results": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["rule_id", "outcome"],
            "properties": {"rule_id": {"type": "string", "minLength": 1}, "outcome": {"type": "string", "enum": ["PASS", "FAIL", "NOT_EVALUATED"]}}
          }
        },
        "evidence_gaps": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["gap_code", "description", "blocking"],
            "properties": {"gap_code": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "blocking": {"const": true}}
          }
        },
        "evidence_packet": {"$ref": "https://spectra.local/schemas/evidence-packet.schema.json"}
      }
    }
  }
}
