{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectra.local/simulation/change-impact.schema.json",
  "title": "SPECTRA MVP Change Impact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "impact_id", "data_class", "baseline_result_id", "variant_result_id", "baseline_hash", "variant_hash", "input_changes", "output_changes", "decision_changes", "invalidated_evidence", "evidence_gaps"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "impact_id": {"type": "string", "pattern": "^impact-[a-f0-9]{16}$"},
    "data_class": {"const": "SYNTHETIC"},
    "baseline_result_id": {"type": "string", "minLength": 1},
    "variant_result_id": {"type": "string", "minLength": 1},
    "baseline_hash": {"$ref": "https://spectra.local/schemas/common.schema.json#/$defs/sha256"},
    "variant_hash": {"$ref": "https://spectra.local/schemas/common.schema.json#/$defs/sha256"},
    "input_changes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/change"}},
    "output_changes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/change"}},
    "decision_changes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/change"}},
    "invalidated_evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_id", "reason_code", "invalidated_for"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "reason_code": {"type": "string", "minLength": 1},
          "invalidated_for": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "evidence_gaps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["gap_code", "description", "blocking"],
        "properties": {
          "gap_code": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "blocking": {"const": true}
        }
      }
    }
  },
  "$defs": {
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "before", "after"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "before": {},
        "after": {},
        "delta": {"type": "number"}
      }
    }
  }
}
