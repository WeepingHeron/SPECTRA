{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectra.local/simulation/simulation-result.schema.json",
  "title": "SPECTRA Synthetic Simulation Result v1",
  "description": "Stage 2 deterministic synthetic Vertical Slice result; never physical radiation assurance evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "data_class", "model", "input_hash", "processing_status", "assurance_decision", "engineering_gate", "metrics", "rule_results", "evidence_gaps", "evidence_packet"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^sim-[a-f0-9]{16}$"},
    "data_class": {"const": "SYNTHETIC"},
    "model": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"const": "SPECTRA_SYNTHETIC_BASELINE_NOT_PHYSICAL"}, "version": {"type": "string", "minLength": 1}}},
    "input_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "processing_status": {"$ref": "https://spectra.local/schemas/common.schema.json#/$defs/processingStatus"},
    "assurance_decision": {"const": "HOLD"},
    "engineering_gate": {"type": "string", "enum": ["PASS", "FAIL", "NOT_EVALUATED"]},
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["shielded_tid", "required_tid", "raw_seu", "residual_seu"],
      "properties": {
        "shielded_tid": {"oneOf": [{"$ref": "https://spectra.local/schemas/common.schema.json#/$defs/quantity"}, {"type": "null"}]},
        "required_tid": {"oneOf": [{"$ref": "https://spectra.local/schemas/common.schema.json#/$defs/quantity"}, {"type": "null"}]},
        "raw_seu": {"oneOf": [{"$ref": "https://spectra.local/schemas/common.schema.json#/$defs/quantity"}, {"type": "null"}]},
        "residual_seu": {"oneOf": [{"$ref": "https://spectra.local/schemas/common.schema.json#/$defs/quantity"}, {"type": "null"}]}
      }
    },
    "rule_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "outcome"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "outcome": {"type": "string", "enum": ["PASS", "FAIL", "NOT_EVALUATED"]}
        }
      }
    },
    "evidence_gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap_code", "description", "blocking"],
        "properties": {
          "gap_code": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"}
        }
      }
    },
    "evidence_packet": {"oneOf": [{"$ref": "https://spectra.local/schemas/evidence-packet.schema.json"}, {"type": "null"}]}
  }
}
