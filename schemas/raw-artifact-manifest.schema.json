{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectra.local/schemas/raw-artifact-manifest.schema.json",
  "title": "External Run Raw Artifact Manifest v1",
  "type": "object", "additionalProperties": false,
  "required": ["manifest_id", "run_id", "bundle_hash", "execution_mode", "distribution_scope", "provider", "timestamps", "artifacts", "parser", "rights", "usage_claims", "metadata"],
  "properties": {
    "manifest_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "bundle_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "execution_mode": {"type": "string", "enum": ["MANUAL", "AUTOMATED"]},
    "distribution_scope": {"type": "string", "enum": ["INTERNAL_RESEARCH", "EXTERNAL_RESEARCH", "COMMERCIAL_PRODUCT"]},
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["platform_name", "platform_version", "provider_job_reference"],
      "properties": {
        "platform_name": {"type": "string", "minLength": 1},
        "platform_version": {"type": "string", "minLength": 1},
        "platform_build": {"type": "string", "minLength": 1},
        "provider_job_reference": {"type": "string", "minLength": 1}
      }
    },
    "timestamps": {
      "type": "object", "additionalProperties": false,
      "required": ["submitted_at", "completed_at", "downloaded_at"],
      "properties": {
        "submitted_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "downloaded_at": {"type": "string", "format": "date-time"}
      }
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_id", "filename", "media_type", "byte_size", "content_hash", "role", "source_location"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "filename": {"type": "string", "minLength": 1},
          "media_type": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
          "byte_size": {"type": "integer", "exclusiveMinimum": 0},
          "content_hash": {"$ref": "common.schema.json#/$defs/sha256"},
          "role": {"type": "string", "enum": ["PROVIDER_INPUT", "PROVIDER_OUTPUT", "RUN_LOG", "CONFIGURATION", "NORMALIZED_OUTPUT"]},
          "source_location": {"type": "string", "minLength": 1}
        }
      }
    },
    "parser": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "commit", "input_bundle_hash", "output_hash"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 1},
        "input_bundle_hash": {"$ref": "common.schema.json#/$defs/sha256"},
        "output_hash": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "rights": {
      "type": "object", "additionalProperties": false,
      "required": ["research", "commercial", "automation", "redistribution"],
      "properties": {
        "research": {"$ref": "#/$defs/rightStatus"},
        "commercial": {"$ref": "#/$defs/rightStatus"},
        "automation": {"$ref": "#/$defs/rightStatus"},
        "redistribution": {"$ref": "#/$defs/rightStatus"}
      }
    },
    "usage_claims": {
      "type": "object", "additionalProperties": false,
      "required": ["research", "commercial", "automation", "redistribution"],
      "properties": {
        "research": {"type": "boolean"}, "commercial": {"type": "boolean"},
        "automation": {"type": "boolean"}, "redistribution": {"type": "boolean"}
      }
    },
    "metadata": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/recordMetadata"},
        {"properties": {"data_class": {"enum": ["CALCULATED", "SYNTHETIC"]}}}
      ]
    }
  },
  "$defs": {"rightStatus": {"type": "string", "enum": ["ALLOWED", "PROHIBITED", "UNCONFIRMED", "NOT_APPLICABLE"]}},
  "allOf": [
    {
      "properties": {
        "artifacts": {
          "contains": {"properties": {"role": {"const": "PROVIDER_OUTPUT"}}, "required": ["role"]},
          "minContains": 1
        }
      }
    }
  ]
}
