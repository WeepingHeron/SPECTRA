{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectra.local/schemas/external-model-run.schema.json",
  "title": "External Radiation Model Chain v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["chain_id", "approved_scope", "representative_stage_id", "stages"],
  "properties": {
    "chain_id": {"type": "string", "minLength": 1},
    "approved_scope": {"type": "string", "enum": ["MISSION_TID_COMPLETE", "TRAPPED_ONLY_RESEARCH", "PARTIAL_RESEARCH"]},
    "representative_stage_id": {"type": "string", "minLength": 1},
    "stages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["stage_id", "role", "model_name", "model_version", "model_build", "depends_on"],
        "properties": {
          "stage_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "enum": ["ORBIT", "TRAPPED_ENVIRONMENT", "SOLAR_ENVIRONMENT", "TRANSPORT_DOSE"]},
          "model_name": {"type": "string", "minLength": 1},
          "model_version": {"type": "string", "minLength": 1},
          "model_build": {"type": "string", "minLength": 1},
          "configuration_reference": {"type": "string", "minLength": 1},
          "configuration_hash": {"$ref": "common.schema.json#/$defs/sha256"},
          "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        },
        "oneOf": [
          {"required": ["configuration_reference"], "not": {"required": ["configuration_hash"]}},
          {"required": ["configuration_hash"], "not": {"required": ["configuration_reference"]}}
        ]
      }
    }
  }
}
