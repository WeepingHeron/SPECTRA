{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectra.local/schemas/raw-artifact-manifest-v2.schema.json",
  "title": "Raw Artifact Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "manifest_id", "run_id", "tenant_id", "zone", "bundle_hash", "create_precondition", "provider", "timestamps", "rights_snapshot", "artifacts", "parser", "metadata"],
  "properties": {
    "contract_version": {"const": "2.0.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "zone": {"type": "string", "enum": ["Z1_PUBLIC_RAW", "Z2_RESTRICTED_RAW", "Z3_CUSTOMER_RAW", "Z5_SYNTHETIC"]},
    "bundle_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "create_precondition": {"const": "IF_GENERATION_MATCH_0"},
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["platform_name", "platform_version", "provider_job_reference"],
      "properties": {
        "platform_name": {"type": "string", "minLength": 1},
        "platform_version": {"type": "string", "minLength": 1},
        "platform_build": {"type": "string", "minLength": 1},
        "provider_job_reference": {"type": "string", "minLength": 1}
      }
    },
    "timestamps": {
      "type": "object", "additionalProperties": false,
      "required": ["submitted_at", "completed_at", "downloaded_at"],
      "properties": {
        "submitted_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "downloaded_at": {"type": "string", "format": "date-time"}
      }
    },
    "rights_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["rights_snapshot_id", "snapshot_version", "status", "tenant_id", "approval_target_hash", "valid_from", "action_grants", "history_anchor_ref"],
      "properties": {
        "rights_snapshot_id": {"type": "string", "minLength": 1},
        "snapshot_version": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["RIGHTS_UNCONFIRMED", "METADATA_ONLY", "PRIVATE_COPY_ALLOWED", "PROCESSING_ALLOWED", "DISPLAY_ALLOWED", "REDISTRIBUTION_ALLOWED", "CUSTOMER_RESTRICTED", "FORBIDDEN", "SYNTHETIC_TEST_ONLY"]},
        "tenant_id": {"type": "string", "minLength": 1},
        "approval_target_hash": {"$ref": "common.schema.json#/$defs/sha256"},
        "valid_from": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"},
        "revoked_at": {"type": "string", "format": "date-time"},
        "action_grants": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["action", "grant_status", "scope_hash"],
            "properties": {
              "action": {"type": "string", "enum": ["LOCATOR", "FETCH", "PRIVATE_STORE", "PROCESS_DOCUMENT_AI", "PROCESS_VERTEX_AI", "DISPLAY_INTERNAL", "DISPLAY_EXTERNAL", "REDISTRIBUTE"]},
              "grant_status": {"type": "string", "enum": ["ALLOWED", "DENIED", "UNCONFIRMED", "NOT_APPLICABLE"]},
              "scope_hash": {"$ref": "common.schema.json#/$defs/sha256"},
              "processor": {"type": "string", "minLength": 1},
              "region": {"type": "string", "minLength": 1},
              "audience": {"type": "string", "minLength": 1},
              "valid_until": {"type": "string", "format": "date-time"}
            }
          }
        },
        "history_anchor_ref": {"type": "string", "minLength": 1}
      }
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_id", "artifact_revision_id", "tenant_id", "zone", "storage_ref", "integrity", "source", "rights_snapshot_id", "validation", "lineage"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "artifact_revision_id": {"type": "string", "minLength": 1},
          "tenant_id": {"type": "string", "minLength": 1},
          "zone": {"type": "string", "enum": ["Z1_PUBLIC_RAW", "Z2_RESTRICTED_RAW", "Z3_CUSTOMER_RAW", "Z5_SYNTHETIC"]},
          "storage_ref": {
            "type": "object", "additionalProperties": false,
            "required": ["project_id", "bucket_id", "object_name", "generation"],
            "properties": {
              "project_id": {"type": "string", "minLength": 1},
              "bucket_id": {"type": "string", "minLength": 1},
              "object_name": {"type": "string", "minLength": 1},
              "generation": {"type": "string", "pattern": "^[1-9][0-9]*$"}
            }
          },
          "integrity": {
            "type": "object", "additionalProperties": false,
            "required": ["sha256", "byte_size", "declared_mime", "detected_mime"],
            "properties": {
              "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
              "byte_size": {"type": "integer", "exclusiveMinimum": 0},
              "declared_mime": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
              "detected_mime": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"}
            }
          },
          "source": {
            "type": "object", "additionalProperties": false,
            "required": ["locator", "retrieved_at"],
            "properties": {"locator": {"type": "string", "minLength": 1}, "retrieved_at": {"type": "string", "format": "date-time"}}
          },
          "rights_snapshot_id": {"type": "string", "minLength": 1},
          "validation": {
            "type": "object", "additionalProperties": false,
            "required": ["quarantine_status", "malware_scan", "mime_check", "hash_check"],
            "properties": {
              "quarantine_status": {"type": "string", "enum": ["QUARANTINED", "VALIDATED", "REJECTED"]},
              "malware_scan": {
                "type": "object", "additionalProperties": false,
                "required": ["status", "engine", "engine_version", "scanned_at"],
                "properties": {"status": {"type": "string", "enum": ["PASS", "FAIL", "INCONCLUSIVE"]}, "engine": {"type": "string", "minLength": 1}, "engine_version": {"type": "string", "minLength": 1}, "scanned_at": {"type": "string", "format": "date-time"}}
              },
              "mime_check": {"type": "string", "enum": ["MATCH", "MISMATCH", "NOT_EVALUATED"]},
              "hash_check": {"type": "string", "enum": ["MATCH", "MISMATCH", "NOT_EVALUATED"]},
              "reviewer": {"type": "string", "minLength": 1},
              "reviewed_at": {"type": "string", "format": "date-time"}
            }
          },
          "lineage": {
            "type": "object", "additionalProperties": false,
            "required": ["derived_record_ids", "deletion_state"],
            "properties": {
              "supersedes_artifact_revision_id": {"type": "string", "minLength": 1},
              "derived_record_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "deletion_state": {"type": "string", "enum": ["ACTIVE", "DELETION_REQUESTED", "DELETION_PENDING_EXPIRY", "DELETED", "LEGAL_HOLD"]},
              "deletion_case_id": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "parser": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "commit", "input_bundle_hash", "output_hash"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 1},
        "input_bundle_hash": {"$ref": "common.schema.json#/$defs/sha256"},
        "output_hash": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "metadata": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/recordMetadata"},
        {"properties": {"data_class": {"enum": ["CALCULATED", "SYNTHETIC"]}}}
      ]
    }
  }
}
