{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectra.local/schemas/user-policy.schema.json",
  "title": "User Policy Input v1",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "policy_id", "approval_status", "tid_design_factor", "maximum_residual_seu", "require_destructive_see_evidence", "metadata"],
  "properties": {
    "kind": {"const": "USER_POLICY"},
    "policy_id": {"type": "string", "minLength": 1},
    "approval_status": {"type": "string", "enum": ["DRAFT", "PENDING_APPROVAL", "APPROVED", "REJECTED"]},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date-time"},
    "tid_design_factor": {"type": "number", "minimum": 1},
    "maximum_residual_seu": {"$ref": "common.schema.json#/$defs/quantity"},
    "require_destructive_see_evidence": {"type": "boolean"},
    "metadata": {"$ref": "common.schema.json#/$defs/recordMetadata"}
  },
  "allOf": [{"if": {"properties": {"approval_status": {"const": "APPROVED"}}}, "then": {"required": ["approved_by", "approved_at"]}}]
}
