{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectra.local/schemas/bom.schema.json",
  "title": "BOM Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "bom_id", "components", "metadata"],
  "properties": {
    "kind": {"const": "BOM"},
    "bom_id": {"type": "string", "minLength": 1},
    "components": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["component_id", "identity", "function"],
        "properties": {
          "component_id": {"type": "string", "minLength": 1},
          "identity": {"$ref": "common.schema.json#/$defs/partIdentity"},
          "function": {"type": "string", "minLength": 1}
        }
      }
    },
    "metadata": {"$ref": "common.schema.json#/$defs/recordMetadata"}
  }
}
