{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectra.local/schemas/part-test-evidence.schema.json",
  "title": "Part Test Evidence Input v1",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "evidence_id", "component_id", "tested_identity", "evidence_types", "test_conditions", "metadata"],
  "properties": {
    "kind": {"const": "PART_TEST_EVIDENCE"},
    "evidence_id": {"type": "string", "minLength": 1},
    "component_id": {"type": "string", "minLength": 1},
    "tested_identity": {"$ref": "common.schema.json#/$defs/partIdentity"},
    "evidence_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["TID", "SEU", "SEL", "SEB", "SEGR"]}},
    "tid_test_limit": {"$ref": "common.schema.json#/$defs/quantity"},
    "cross_section": {"$ref": "common.schema.json#/$defs/quantity"},
    "test_conditions": {"type": "object", "additionalProperties": false, "required": ["facility", "test_date", "bias_condition", "temperature_c"], "properties": {"facility": {"type": "string", "minLength": 1}, "test_date": {"type": "string", "format": "date"}, "bias_condition": {"type": "string", "minLength": 1}, "temperature_c": {"type": "number"}}},
    "metadata": {"$ref": "common.schema.json#/$defs/recordMetadata"}
  },
  "allOf": [
    {"if": {"properties": {"evidence_types": {"contains": {"const": "TID"}}}}, "then": {"required": ["tid_test_limit"]}},
    {"if": {"properties": {"evidence_types": {"contains": {"const": "SEU"}}}}, "then": {"required": ["cross_section"]}}
  ]
}
